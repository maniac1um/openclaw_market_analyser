# Docker 一键部署用环境变量（应用容器连接 compose 内 postgres 服务）
# 由 scripts/deploy/one-click-docker.sh 复制为 .env

OPENCLAW_OPENCLAW_API_KEY=dev-openclaw-key
# Gateway 运行在宿主机时，容器经 host.docker.internal 访问
OPENCLAW_OPENCLAW_WS_URL=ws://host.docker.internal:18789/ws

OPENCLAW_DATABASE_URL=postgresql://openclaw_app:openclaw_dev@postgres:5432/openclaw_app
OPENCLAW_MONITORING_DATABASE_URL=postgresql://openclaw_monitor:openclaw_dev@postgres:5432/openclaw_monitor
OPENCLAW_NEWS_DATABASE_URL=postgresql://openclaw_news:openclaw_dev@postgres:5432/openclaw_news

OPENCLAW_BIND_HOST=0.0.0.0
OPENCLAW_BIND_PORT=8000
OPENCLAW_SERVE_SPA=true
OPENCLAW_CORS_ORIGINS=
