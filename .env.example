# OpenClaw News Publisher — environment template
# Copy: cp .env.example .env

# --- Authentication & Gateway ---
# Legacy 全局 Key（默认关闭；true 时映射 ADMIN，仅过渡期）
OPENCLAW_OPENCLAW_API_KEY=dev-openclaw-key
OPENCLAW_OPENCLAW_ENABLE_SIGNATURE=false
OPENCLAW_OPENCLAW_HMAC_SECRET=dev-secret
OPENCLAW_OPENCLAW_WS_URL=ws://localhost:18789/ws
# Production: set true and use strong secrets (>=16 chars); startup will fail-fast if weak
OPENCLAW_PRODUCTION=false
# Dev: set true to enable Swagger at /docs
OPENCLAW_EXPOSE_OPENAPI=false
OPENCLAW_RATE_LIMIT_ENABLED=true
OPENCLAW_TRUST_X_FORWARDED_FOR=false
OPENCLAW_WS_MESSAGES_PER_MINUTE=12
# Chat turn: max idle seconds waiting for next Gateway event / max total seconds per turn
OPENCLAW_CHAT_RECV_TIMEOUT_SECONDS=120
OPENCLAW_CHAT_TOTAL_TIMEOUT_SECONDS=600
OPENCLAW_EXPOSE_GATEWAY_WS_URL=false
OPENCLAW_MAX_REQUEST_BODY_BYTES=1048576
OPENCLAW_HEALTHZ_EXPOSE_DB_DETAIL=false

# --- Multi-user auth ---
OPENCLAW_JWT_SECRET=dev-jwt-secret-change-me-in-production
OPENCLAW_JWT_ACCESS_TTL=900
OPENCLAW_JWT_REFRESH_TTL=604800
OPENCLAW_ALLOW_REGISTRATION=true
OPENCLAW_FIRST_USER_IS_ADMIN=true
OPENCLAW_LEGACY_API_KEY_ENABLED=false
OPENCLAW_LOGIN_MAX_ATTEMPTS=5
OPENCLAW_LOGIN_LOCKOUT_SECONDS=900

# --- PostgreSQL (three databases, can share one host) ---
OPENCLAW_DATABASE_URL=postgresql://openclaw_app:REPLACE_ME@127.0.0.1:5432/openclaw_app
OPENCLAW_MONITORING_DATABASE_URL=postgresql://openclaw_monitor:REPLACE_ME@127.0.0.1:5432/openclaw_monitor
OPENCLAW_NEWS_DATABASE_URL=postgresql://openclaw_news:REPLACE_ME@127.0.0.1:5432/openclaw_news

# --- Server ---
OPENCLAW_BIND_HOST=0.0.0.0
OPENCLAW_BIND_PORT=8000
OPENCLAW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENCLAW_SERVE_SPA=true
# 禁止向 SPA HTML 注入 API Key（默认 false）；门户使用 JWT + Refresh Cookie
OPENCLAW_PORTAL_EMBED_API_KEY_IN_SPA=false
# 已废弃：勿在 Vite/SPA 中嵌入 API Key；Agent 使用门户 /account 生成的 per-user Key

# --- Git publish (optional) ---
OPENCLAW_GIT_AUTO_PUSH=false
OPENCLAW_GIT_REMOTE=origin
OPENCLAW_GIT_BRANCH=main

# --- Price monitoring (default: external ingest, no server scrape) ---
OPENCLAW_MONITORING_ALLOW_SERVER_SCRAPE=false
OPENCLAW_MONITORING_SCHEDULER_ENABLED=false
